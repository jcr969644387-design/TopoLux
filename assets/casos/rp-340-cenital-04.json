    "correcta": "repetir",
    "justificaciones": [
      {
        "id": "j1",
        "texto": "La planimetría cierra correctamente pero la cota queda fuera de tolerancia con el desnivel invertido en un tramo: el dato vertical no es recuperable en gabinete.",
        "correcta": true
      },
      {
        "id": "j2",
        "texto": "El error de cota se corrige aplicando la corrección por curvatura y refracción.",
        "correcta": false,
        "tipo_distractor": "tecnicamente_falso"
      },
      {
        "id": "j3",
        "texto": "Como la planimetría cierra, el levantamiento se acepta y la cota se interpola.",
        "correcta": false,
        "tipo_distractor": "confusion_frecuente"
      },
      {
        "id": "j4",
        "texto": "La rampa tiene fuerte pendiente, y a mayor pendiente mayor error de distancia inclinada.",
        "correcta": false,
        "tipo_distractor": "cierto_pero_irrelevante"
      }
    ]
  },
  "consecuencia": {
    "aceptar": {
      "texto": "Entregaste un control con la cota errada en {{error_cota_m}} m. La gradiente replanteada dejó un tramo contrapendiente y la rampa acumuló agua en la curva.",
      "impacto": "alto"
    },
    "compensar": {
      "texto": "Compensaste un desnivel invertido. La compensación repartió un disparate entre todos los tramos y ninguna cota quedó utilizable.",
      "impacto": "alto"
    },
    "repetir": {
      "texto": "La brigada reobservó el tramo. Se confirmó que la lectura vertical estaba mal anotada y el control de gradiente quedó correcto.",
      "impacto": "bajo"
    },
    "escalar": {
      "texto": "Reportaste sin resolver. La respuesta fue reobservar, que era la decisión disponible desde el inicio.",
      "impacto": "medio"
    }
  },
  "diagnostico": {
    "que_habia": "En la estación señalada se anotó el ángulo vertical donde la libreta pedía el ángulo cenital, con el complemento tomado al revés.",
